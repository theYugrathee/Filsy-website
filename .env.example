# ==========================================
# FILSY WEBSITE & PAYMENT CONFIGURATION
# ==========================================

# 1. Product & Pricing Configuration (Editable anytime)
VITE_PRODUCT_NAME="Filsy"
VITE_PRODUCT_VERSION="1.0.0"
VITE_LIFETIME_PRICE_USD="29"
VITE_LIFETIME_PRICE_INR="1999"
VITE_SUPPORT_EMAIL="support@filsy.app"
VITE_DOWNLOAD_URL="https://github.com/filsy-app/releases/releases/download/v1.0.0/Filsy-Setup-1.0.0.exe"

# 2. Dodo Payments Integration (Zero Upfront Cost)
# Get your API keys at https://app.dodopayments.com/
# Use test mode keys (dodo_test_...) during development
DODO_PAYMENTS_API_KEY="dodo_live_xxxxxxxxxxxxxxxxxxxx"
DODO_PAYMENTS_WEBHOOK_KEY="whsec_xxxxxxxxxxxxxxxxxxxx"
DODO_PRODUCT_ID="p_xxxxxxxxxxxx"
DODO_MODE="test" # "test" or "live"

# 3. Supabase Configuration (Free Tier: 500MB DB, 50k monthly active users)
# Used for storing activated license keys and device bindings
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx"

# 4. Public Site URL
VITE_SITE_URL="https://filsy.app"
